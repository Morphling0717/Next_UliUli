# ========== 基础：Admin 与主站 ==========
# 后台 /admin 的管理员密码；如果未单独配置 MAIL_AUTH_PASSWORD，/mail 也会回退使用它
ADMIN_PASSWORD=change_me_to_a_strong_password
# [可选] 发信箱后台 /mail 独立密码；留空则回退到 ADMIN_PASSWORD
MAIL_AUTH_PASSWORD=
# 解锁隐藏内容（隐藏视频 / 隐藏歌单）的"开发者密码"
DEV_UNLOCK_PASSWORD=change_me_to_a_dev_unlock_password
# SQLite 数据库文件路径；Docker 部署时 compose 里会覆盖为 /app/data/codes.db
DATABASE_PATH=./data/codes.db
# Docker Compose 暴露到宿主机的本地端口；模板只绑定 127.0.0.1，避免绕过反代直连 Node。
HOST_PORT=3000
# SQLite 备份目录；默认是数据库文件旁边的 backups 目录
DB_BACKUP_DIR=
# 最多保留多少个 codes-*.db 备份
DB_BACKUP_RETENTION=20
# 健康检查允许的最大备份年龄，超过后 /api/health 会降级为 degraded。
DB_BACKUP_MAX_AGE_HOURS=48
# 网站公开访问地址（用于 Open Graph 分享卡片，必须是完整的 https 地址）
NEXT_PUBLIC_SITE_URL=https://uliuli.cn

# ========== 发信箱（MAIL_BOX）==========
# 新安装请生成稳定随机盐（例如 openssl rand -hex 32），并与数据库一同备份。
# 已有安装升级或换服务器必须保留原值，否则原屏蔽身份无法匹配。
# 未定义此变量才使用本站历史 fallback；旧配置 WINDCHIME_HASH_SALT= 表示空盐，
# 升级须继续保留空字符串，不能改为 fallback 或重新生成。
WINDCHIME_HASH_SALT=

# [可选] 敏感词初始值（英文逗号分隔）。只在 DB 里没有记录时作为默认值读取，
# 之后以后台页面里保存的 DB 值为准。
# MAIL_BLOCKED_TERMS=政治,色情,赌博

# [可选] Cloudflare Turnstile 人机校验。需要两个都设置才会启用；
# 留空则跳过验证（客户端限流 + 服务端 IP/指纹限流仍然生效）。
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# ========== B 站数据代理 ==========
# 前端只请求 /api/bilibili；这里配置服务器侧上游接口。
BILIBILI_API_URL=https://api.uliuli.cn/api?mid=3546779356235807&section=profile,videos&page_size=15&order=pubdate
# 站内代理缓存秒数，默认 180 秒。
BILIBILI_CACHE_TTL_SECONDS=180
# 上游请求超时毫秒数，默认 8000。
BILIBILI_FETCH_TIMEOUT_MS=8000
# 上游临时失败后的后台刷新退避秒数，默认 60 秒。
BILIBILI_REFRESH_ERROR_BACKOFF_SECONDS=60

# ========== 风铃 0.6 私人控制台 /mail/live ==========
# 反向代理后的本站公开 HTTPS Origin；不带路径，必须与浏览器地址一致。
WINDCHIME_SITE_ORIGIN=
# 只允许受信任的独立展示页 Origin，多个用英文逗号分隔；不能填 *。
WINDCHIME_LIVE_ORIGINS=
# 独立展示页完整地址（构建时变量），例如 https://live.example.com/display
NEXT_PUBLIC_WINDCHIME_DISPLAY_URL=
# 私有规范化图片持久目录，不能位于 public/ 下；与数据库一同备份。
WINDCHIME_MEDIA_DIRECTORY=./data/mail-media
# B 站密钥仅在独立网关配置。网站只配置网关地址和 Ed25519 公钥。
WINDCHIME_GATEWAY_ORIGIN=
WINDCHIME_GATEWAY_KEY_ID=default
# 可使用带字面量 \n 的 PEM 公钥；不得填网关私钥。
WINDCHIME_GATEWAY_PUBLIC_KEY=
